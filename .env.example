# Copy to .env.local and fill in. Never commit real values.

# PayPal sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The webhook registered in that app for <backend URL>/api/paypal/webhook (CAPTURE COMPLETED, DENIED, DECLINED).
# Without it, webhooks are refused and "Check again" still settles pending payments.
PAYPAL_WEBHOOK_ID=

# Where PayPal sends the buyer back after approving (backend/paypal.py). Default: http://localhost:3000
APP_URL=
# Lets the Render cron job (backend/cron_sweep.py) call POST /api/cron/sweep. Render generates it (render.yaml); leave
# empty locally to keep the route off.
CRON_SECRET=
# Where Next.js proxies /api/* (next.config.ts). Default: http://127.0.0.1:8000. Must be set at build time.
BACKEND_URL=

OLLAMA_API_KEY=
OLLAMA_MODEL=

# Not used for now: receipt matching runs on Ollama (decision 38). Kept for when Claude Haiku comes back.
ANTHROPIC_API_KEY=
# AWS Textract reads receipts and paper lists; without it the Ollama vision model does. An IAM user with only textract:AnalyzeExpense and textract:DetectDocumentText is enough.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Default: us-east-1
AWS_REGION=

# Channel3 store search (backend/market.py, decision 50): https://trychannel3.com/developers
CHANNEL3_API_KEY=

# Grocery prices from Kroger (decision 74): a free account at https://developer.kroger.com, an app with the
# Products API. Prices are a store's own, so set its location ID, or a ZIP code to use the nearest Kroger store.
# Leave these out and groceries keep the AI's guess.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_ZIP=
# KROGER_LOCATION_ID=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
