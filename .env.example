# Sandbox app credentials from https://developer.paypal.com/dashboard/applications/sandbox
# Copy this file to .env.local and fill in both values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# From the Supabase dashboard: Project Settings > API Keys. The secret key (sb_secret_...) is for the backend only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Where Next.js sends /api/* requests. Leave unset locally; the default is http://127.0.0.1:8000.
# BACKEND_URL=

# From https://ollama.com/settings/keys. Used by backend/llm.py to call the hosted model.
# OLLAMA_MODEL must be a vision-capable model the key can use.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
