# Copy this file to .env.local and fill it in. Both servers read .env.local (decision 35).
# Never commit .env.local.

# PayPal SANDBOX app credentials. Never put live credentials here.
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# From the Supabase dashboard: Project Settings > API Keys. The secret key (sb_secret_...) is for the backend only.
# Run supabase/schema.sql in the SQL editor once before starting.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# The LLM, through the Ollama API. The model must accept images (it reads receipts).
# Key from https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# Optional. The default is Ollama's cloud, https://ollama.com. Set it to use another Ollama server.
# OLLAMA_HOST=

# Where Next.js sends /api/* requests. Leave both unset locally; the default is http://127.0.0.1:8000.
# BACKEND_URL is a full URL. BACKEND_HOSTPORT is host:port, which is what Render provides (render.yaml).
# BACKEND_URL=
# BACKEND_HOSTPORT=
